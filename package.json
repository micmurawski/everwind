{
  "name": "tbln",
  "version": "0.1.0",
  "description": "Small, explicit, durable agent loops for TypeScript and Bun",
  "keywords": [
    "agent",
    "llm",
    "durable-execution",
    "bun",
    "typescript",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micmurawski/tourbillon.git"
  },
  "homepage": "https://github.com/micmurawski/tourbillon#readme",
  "bugs": {
    "url": "https://github.com/micmurawski/tourbillon/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./python": {
      "types": "./dist/python/index.d.ts",
      "bun": "./dist/python/index.js",
      "import": "./dist/python/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs"
  ],
  "engines": {
    "bun": ">=1.0.25"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.68",
    "openai": ">=4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^5"
  }
}
